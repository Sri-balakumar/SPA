{
  "expo": {
    "name": "Stretch & Go",
    "slug": "spa-app",
    "scheme": "spaapp",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "backgroundColor": "#ffffff",
    "icon": "./assets/icon.png",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.spa.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow the Spa app to scan the device registration QR code."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "f87944f3-1730-465e-b200-957d810299b6"
      }
    }
  }
}
