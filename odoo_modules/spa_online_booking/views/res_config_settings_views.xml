<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.spa.online.booking</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Spa Online Booking" string="Spa Online Booking"
                     name="spa_online_booking">
                    <block title="Online Booking" name="spa_online_booking_block">
                        <setting string="Minimum booking notice"
                                 help="Customers can only book a slot at least this many hours in advance. 0 = same-day booking allowed up to the slot time.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="spa_min_lead_hours" class="o_light_label"/>
                                    <span class="ms-2">hours</span>
                                </div>
                            </div>
                        </setting>
                        <setting string="Maximum booking notice"
                                 help="Customers cannot book a slot more than this many hours in advance (e.g. 720 = 30 days). 0 = no maximum.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="spa_max_lead_hours" class="o_light_label"/>
                                    <span class="ms-2">hours</span>
                                </div>
                            </div>
                        </setting>
                        <setting string="Package footer note"
                                 help="Small print under the package list on the POS Book Therapy screen and the booking page, e.g. &quot;Prices in OMR • Valid 3 months&quot;. Leave empty to show nothing.">
                            <div class="content-group">
                                <div class="mt16">
                                    <field name="spa_package_note" class="o_light_label"
                                           placeholder="Prices in OMR • Valid 3 months"/>
                                </div>
                            </div>
                        </setting>
                        <setting string="Starter data"
                                 help="Earlier versions created four sample therapies and sixteen packages on install. This removes them, and can untick categories that were flagged as therapies by the old default. Anything sold, booked or priced is kept and listed.">
                            <div class="content-group">
                                <div class="mt16">
                                    <button name="%(spa_online_booking.action_spa_starter_cleanup)d"
                                            type="action" string="Remove Starter Data"
                                            class="btn-secondary"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                    <block title="Session Assignee" name="spa_assignee_block">
                        <setting string="Assignee mandatory"
                                 help="Require a member of staff on every session. When ON, an order cannot be paid and a prepaid session cannot be marked done until each session names who is giving it. When OFF, the assignee is still recorded everywhere it is set — on the order card, at Approve and in Redeem — and shows on the invoice and the sales report, but nothing is blocked. Only Spa Reception and the administrator can assign either way.">
                            <field name="spa_assign_required"/>
                        </setting>
                    </block>
                    <block title="Package Prices" name="spa_savings_block">
                        <setting string="Hide &quot;Save&quot; amount"
                                 help="Hide the green &quot;Save X&quot; line under each package, on the POS Book Therapy screen and on the online booking page.">
                            <field name="spa_hide_savings"/>
                        </setting>
                    </block>
                    <block title="Health Questionnaire" name="spa_health_block">
                        <setting string="Reuse answers on file (Healthy tick)"
                                 help="Returning customers see a &quot;Healthy - no changes&quot; tick with the date their answers were last updated. Ticked: the questions and the signature on file are reused. Unticked: the questions open pre-filled so they can be updated. When OFF, the full questionnaire is asked on every visit.">
                            <field name="spa_health_reuse"/>
                        </setting>
                    </block>
                    <block title="WhatsApp Delivery" name="spa_whatsapp_block">
                        <setting string="WhatsApp Session"
                                 help="Booking links are sent directly on this WhatsApp session. If empty or disconnected, the first connected session is used.">
                            <field name="spa_whatsapp_session_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <!-- Under Settings -> Point of Sale: toggles for the Orders-screen tabs. -->
    <record id="res_config_settings_view_form_pos_spa" model="ir.ui.view">
        <field name="name">res.config.settings.pos.spa.channels</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='restaurant_section']" position="after">
                <block title="Spa Order Tabs" name="spa_channels_section"
                       help="Choose which channel tabs appear in the POS Orders screen.">
                    <setting string="Online tab"
                             help="Show the Online (link booking) tab in the POS Orders screen.">
                        <field name="pos_spa_show_online"/>
                    </setting>
                    <setting string="Web tab"
                             help="Show the Web (manual) tab in the POS Orders screen.">
                        <field name="pos_spa_show_web"/>
                    </setting>
                    <setting string="Tab tab"
                             help="Show the Tab (tablet kiosk) tab in the POS Orders screen.">
                        <field name="pos_spa_show_tab"/>
                    </setting>
                </block>
                <block title="Spa Invoicing" name="spa_invoicing_section">
                    <setting string="Invoice every order automatically"
                             help="The Invoice button starts ticked on every new order, so each sale gets an invoice (and the Invoice button on the Orders screen). The order cannot be paid until a customer is selected.">
                        <field name="pos_spa_auto_invoice"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>

    <record id="action_spa_online_booking_config" model="ir.actions.act_window">
        <field name="name">Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="context">{'module': 'spa_online_booking'}</field>
    </record>

    <menuitem id="menu_spa_online_booking_config"
              name="Online Booking Settings"
              parent="point_of_sale.menu_point_config_product"
              action="action_spa_online_booking_config"
              sequence="90"/>

</odoo>
