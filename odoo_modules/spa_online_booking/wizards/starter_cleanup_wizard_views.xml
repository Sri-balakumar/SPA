<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_spa_starter_cleanup_form" model="ir.ui.view">
        <field name="name">spa.starter.cleanup.form</field>
        <field name="model">spa.starter.cleanup</field>
        <field name="arch" type="xml">
            <form string="Remove Starter Data">
                <div class="alert alert-info" role="alert">
                    Older versions of this module created a sample catalogue on
                    install. Removing the data file does not remove what it
                    already created, so this does. Nothing that has been sold,
                    booked or priced is touched — it is listed instead.
                </div>
                <group>
                    <field name="preview" nolabel="1" readonly="1"
                           widget="text" class="text-muted"/>
                </group>
                <group string="What to remove">
                    <field name="remove_catalogue"/>
                    <field name="untick_categories"/>
                    <field name="remove_member_types"/>
                </group>
                <group string="Result" invisible="not report">
                    <field name="report" nolabel="1" readonly="1" widget="text"/>
                </group>
                <footer>
                    <button name="action_apply" string="Remove Selected"
                            type="object" class="btn-primary"
                            confirm="Remove the selected starter data? Records in use will be kept and listed."/>
                    <button name="action_refresh" string="Refresh"
                            type="object" class="btn-secondary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_spa_starter_cleanup" model="ir.actions.act_window">
        <field name="name">Remove Starter Data</field>
        <field name="res_model">spa.starter.cleanup</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
