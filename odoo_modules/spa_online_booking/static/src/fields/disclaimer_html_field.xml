<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- The stock HtmlField template with a permanent toolbar bar underneath -
         the writing box on top, the buttons below it, the way an email compose
         window is laid out. Kept as a copy rather than an xpath because the
         upstream template is small and an inherited patch on it would be far
         more likely to break silently on an Odoo upgrade. -->
    <t t-name="spa_online_booking.DisclaimerHtmlField">
        <t t-if="this.displayReadonly">
            <HtmlViewer config="getReadonlyConfig()" migrateHTML="false"/>
        </t>
        <div t-else="" class="spa-disc-editor"
             t-att-class="{'o_show_codeview': state.showCodeView, 'o_field_translate': isTranslatable}">
            <t t-if="state.showCodeView">
                <textarea t-ref="codeView" class="o_codeview" t-att-value="this.value" t-on-change="onChange"/>
            </t>
            <t t-if="!this.sandboxedPreview">
                <Wysiwyg
                    config="this.getConfig()"
                    onLoad.bind="onEditorLoad"
                    contentClass="`note-editable ${this.state.showCodeView ? 'd-none' : ''}`"
                    onBlur.bind="onBlur"
                    t-key="wysiwygKey"/>
            </t>

            <!-- Renders only once the toolbar plugin has been found; if it
                 never is, the field degrades to a plain Html field and the
                 usual selection overlay still works. -->
            <div t-if="fixedToolbarProps" class="spa-disc-toolbar">
                <Toolbar t-props="fixedToolbarProps"/>
            </div>

            <t t-if="isTranslatable">
                <TranslationButton fieldName="props.name" record="props.record"/>
            </t>
        </div>
        <div t-if="state.showCodeView || (sandboxedPreview and !props.readonly)"
             t-ref="codeViewButton" id="codeview-btn-group" class="btn-group" t-on-click="toggleCodeView">
            <button class="o_codeview_btn btn btn-primary">
                <i class="fa fa-code"/>
            </button>
        </div>
    </t>

</templates>
