<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="spa_online_booking.SpaSignDialog">
        <Dialog size="'lg'" title="'Customer Signature'" contentClass="'sg-redeem-dialog'">
            <t t-set-slot="header">
                <h4 class="modal-title flex-grow-1 sg-redeem__dialog-title">Customer Signature</h4>
                <button type="button" class="btn-close" aria-label="Close" t-on-click="() => this.props.close()"/>
            </t>

            <div class="sg-redeem sg-sign">
                <div class="sg-redeem__head">
                    <div>
                        <div class="sg-redeem__who"><i class="fa fa-user me-1"/><t t-esc="sheet.customer"/></div>
                        <div class="text-muted" t-if="sheet.title" t-esc="sheet.title"/>
                    </div>
                </div>

                <div class="sg-rep-meta">
                    <div class="sg-rep-meta__row"><span>Receipt No</span><b t-esc="sheet.order_ref or '—'"/></div>
                    <div class="sg-rep-meta__row"><span>Invoice No</span><b t-esc="sheet.invoice or '—'"/></div>
                    <div class="sg-rep-meta__row" t-if="sheet.date"><span>Date</span><b t-esc="sheet.date"/></div>
                    <div class="sg-rep-meta__row" t-if="sheet.phone"><span>Phone</span><b t-esc="sheet.phone"/></div>
                    <div class="sg-rep-meta__row" t-if="sheet.amount_total"><span>Total</span><b t-esc="money(sheet.amount_total)"/></div>
                </div>

                <h5 class="tp-section">Questions &amp; Answers</h5>
                <p t-if="!sheet.groups or !sheet.groups.length" class="text-muted">
                    No questionnaire answers recorded for this receipt.
                </p>
                <div t-foreach="sheet.groups or []" t-as="g" t-key="g_index" class="sg-qa-group">
                    <div class="sg-qa-group__head">
                        <i class="fa fa-file-text-o me-1 text-muted"/>
                        <b t-esc="g.service or sheet.title"/>
                        <!-- Whose answers these are. Blank on an individual
                             booking, so that sheet reads exactly as before. -->
                        <span t-if="g.person" class="sg-qa-group__person">
                            <i class="fa fa-user me-1"/><t t-esc="g.person"/>
                            <span class="text-muted ms-1" t-esc="g.person_label"/>
                        </span>
                        <span class="text-muted ms-2" t-esc="groupHead(g)"/>
                    </div>
                    <div class="sg-ans-row" t-foreach="g.rows or []" t-as="qa" t-key="qa_index">
                        <div class="sg-ans-q"><t t-esc="qa.question"/></div>
                        <div class="sg-ans-a"><t t-esc="qa.answer"/></div>
                    </div>
                </div>

                <!-- The waiver the customer accepted, collapsed by default so
                     it does not bury the answers and the signature. Click the
                     header to read the whole thing. -->
                <t t-if="sheet.disclaimers and sheet.disclaimers.length">
                    <h5 class="tp-section">Disclaimer</h5>
                    <div t-foreach="sheet.disclaimers" t-as="d" t-key="d_index"
                         class="sg-disc">
                        <button class="sg-disc__head" t-on-click="() => this.toggleDisclaimer(d_index)">
                            <i t-attf-class="fa {{ isDisclaimerOpen(d_index) ? 'fa-caret-down' : 'fa-caret-right' }} me-2"/>
                            <span class="sg-disc__title"><t t-esc="d.title"/></span>
                            <span class="sg-disc__accepted">
                                <i class="fa fa-check-circle me-1"/>Accepted
                            </span>
                        </button>
                        <div t-if="isDisclaimerOpen(d_index)" class="sg-disc__body">
                            <!-- Rich text from the editor, sanitize=True server
                                 side, so rendered as markup like everywhere else. -->
                            <div t-out="html(d.body)"/>
                            <p t-if="!d.as_signed" class="sg-disc__note">
                                This is the therapy's current wording — this signature
                                was taken before the text was being stored with it.
                            </p>
                        </div>
                    </div>
                </t>

                <h5 class="tp-section">Signature</h5>
                <SpaSignatureField sig="state.sig" label="''"
                                   hint="'Ask the customer to sign inside the box, or upload a picture of the signature.'"/>

                <p t-if="state.error" class="text-danger mt-2 mb-0"><t t-esc="state.error"/></p>
            </div>

            <t t-set-slot="footer">
                <button class="sg-redeem__closebtn sg-rep-print" t-att-disabled="state.busy"
                        t-on-click="() => this.saveAndPrint()">
                    <i class="fa fa-print me-1"/>
                    <t t-esc="state.busy ? 'Saving…' : 'Save &amp; Print'"/>
                </button>
                <button class="sg-redeem__closebtn" t-on-click="() => this.props.close()">Close</button>
            </t>
        </Dialog>
    </t>

</templates>
