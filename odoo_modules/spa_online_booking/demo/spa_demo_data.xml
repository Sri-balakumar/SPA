         ============================================================ -->

    <record id="demo_heading_ease_health" model="spa.question.heading">
        <field name="name">Health &amp; Safety</field>
        <field name="sequence">10</field>
        <field name="pos_category_id" ref="demo_therapy_ease"/>
    </record>

    <record id="demo_heading_ease_pref" model="spa.question.heading">
