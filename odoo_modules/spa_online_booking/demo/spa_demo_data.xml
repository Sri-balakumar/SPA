<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Demo catalogue for the tablet app and the online booking page.

        Shape mirrors what GET /api/spa/therapies returns:
          THERAPY  = pos.category with spa_is_therapy = True
          PACKAGE  = product.template (type=service) filed under that category
          QUESTIONS= spa.question rows owned by the therapy, grouped by heading

        Pricing follows the rule in the app's data/packages.js:
          Single = 1x   Starter (4+1) = 4x   Commit (8+1) = 8x   Lifestyle (12+2) = 12x
        so the "Save X" badge the controller computes has something to show.
    -->

    <!-- ============================================================
         THERAPIES
         ============================================================ -->

    <record id="demo_therapy_ease" model="pos.category">
        <field name="name">GO Ease</field>
        <field name="spa_is_therapy" eval="True"/>
        <field name="spa_sequence">10</field>
        <field name="spa_tagline">Light, relaxing assisted stretching</field>
        <field name="spa_description" type="html">
            <p>A light and relaxing assisted stretching session designed to release
               daily muscle tension and improve overall comfort. Perfect for a first
               experience of assisted stretching, or a quick recovery session.</p>
        </field>
        <field name="spa_ideal_for">Beginners, Office Workers, Daily Tension Relief</field>
        <field name="spa_focus_areas">Neck, Shoulders, Upper Back</field>
    </record>

    <record id="demo_therapy_flex" model="pos.category">
        <field name="name">GO Flex</field>
        <field name="spa_is_therapy" eval="True"/>
        <field name="spa_sequence">20</field>
        <field name="spa_tagline">Deeper release, better mobility</field>
        <field name="spa_description" type="html">
            <p>A focused assisted stretching session designed to release deeper muscle
               tension and improve flexibility. Ideal for anyone looking for a more
               complete stretch and better day-to-day body mobility.</p>
        </field>
        <field name="spa_ideal_for">Active Adults, Gym Goers, Improved Flexibility</field>
        <field name="spa_focus_areas">Shoulders, Back, Hips, Hamstrings</field>
    </record>

    <record id="demo_therapy_relief" model="pos.category">
        <field name="name">GO Relief</field>
        <field name="spa_is_therapy" eval="True"/>
        <field name="spa_sequence">30</field>
        <field name="spa_tagline">Therapeutic relief and recovery</field>
        <field name="spa_description" type="html">
            <p>A therapeutic assisted stretching session designed to relieve deep muscle
               pain, reduce tension and support better recovery. Ideal for anyone
               experiencing stiffness, fatigue or muscle discomfort.</p>
        </field>
        <field name="spa_ideal_for">Chronic Tension, Post-Workout Recovery, Desk Fatigue</field>
        <field name="spa_focus_areas">Neck, Back, Hips, Legs</field>
    </record>

    <record id="demo_therapy_release" model="pos.category">
        <field name="name">GO Release</field>
        <field name="spa_is_therapy" eval="True"/>
        <field name="spa_sequence">40</field>
        <field name="spa_tagline">Full-body deep release</field>
        <field name="spa_description" type="html">
            <p>An extended assisted stretching session designed for deep muscle release
               and full-body relaxation. For a complete recovery experience and maximum
               flexibility improvement.</p>
        </field>
        <field name="spa_ideal_for">Athletes, Deep Recovery, Full-Body Reset</field>
        <field name="spa_focus_areas">Full Body — Neck, Shoulders, Back, Hips, Legs</field>
    </record>

    <!-- ============================================================
         PACKAGES — GO Ease (30 min, single = 12)
         ============================================================ -->

    <record id="demo_pkg_ease_single" model="product.template">
        <field name="name">GO Ease — Single Session</field>
        <field name="type">service</field>
        <field name="list_price">12.0</field>
        <field name="spa_session_count">1</field>
        <field name="spa_duration">30</field>
        <field name="spa_session_desc">A light and relaxing assisted stretching session to release daily muscle tension and improve overall comfort.</field>
        <field name="available_in_pos" eval="True"/>
        <field name="pos_categ_ids" eval="[(6, 0, [ref('demo_therapy_ease')])]"/>
    </record>

