<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Customer numbers printed on the invoice. noupdate so the counter is
         never rewound by a module upgrade - a number that has been printed on
         a document must not be handed to somebody else later. -->
    <data noupdate="1">
        <record id="seq_spa_customer_id" model="ir.sequence">
            <field name="name">Spa Customer ID</field>
            <field name="code">spa.customer.id</field>
            <field name="prefix">CUST-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>

</odoo>
