<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        No `res.groups.privilege` record and no `privilege_id` here, on purpose.
        Odoo 19 changed that shape partway through its life and this file has to
        load on either side of the change - see _link_groups_to_app() in this
        module's __init__.py, which does the filing afterwards against whatever
        the running build actually has.

        noupdate so that neither the groups nor the category are ever candidates
        for removal when this file changes again.
    -->
    <data noupdate="1">

        <record id="module_category_spa" model="ir.module.category">
            <field name="name">Spa</field>
            <field name="sequence">25</field>
        </record>

        <record id="group_spa_receptionist" model="res.groups">
            <field name="name">Spa Receptionist</field>
        </record>

        <record id="group_spa_manager" model="res.groups">
            <field name="name">Spa Manager</field>
            <field name="implied_ids" eval="[(4, ref('group_spa_receptionist'))]"/>
        </record>

    </data>
</odoo>
