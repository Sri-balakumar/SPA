<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_spa" model="ir.module.category">
        <field name="name">Spa</field>
        <field name="sequence">25</field>
    </record>

    <record id="privilege_spa" model="res.groups.privilege">
        <field name="name">Spa</field>
        <field name="category_id" ref="module_category_spa"/>
    </record>

    <record id="group_spa_receptionist" model="res.groups">
        <field name="name">Receptionist</field>
        <field name="privilege_id" ref="privilege_spa"/>
    </record>

    <record id="group_spa_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="privilege_id" ref="privilege_spa"/>
        <field name="implied_ids" eval="[(4, ref('group_spa_receptionist'))]"/>
    </record>
</odoo>
